{
  "name": "react-spray",
  "version": "0.2.0",
  "description": "ID insertion for React components",
  "author": "Nicholas Ng",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "identifier",
    "trie"
  ],
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc --outDir dist",
    "postbuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "eslint --fix",
    "test": "jest",
    "debug": "jest --watch"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "react": "19.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.1.13",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "babel-jest": "30.1.2",
    "eslint": "9.36.0",
    "jest": "30.1.3",
    "jest-environment-jsdom": "30.1.2",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-jest": "29.4.4",
    "typescript": "5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onenylxus/react-spray.git"
  },
  "bugs": {
    "url": "https://github.com/onenylxus/react-spray/issues"
  },
  "homepage": "https://github.com/onenylxus/react-spray#readme"
}
